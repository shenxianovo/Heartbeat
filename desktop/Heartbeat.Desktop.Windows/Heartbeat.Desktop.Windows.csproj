<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Heartbeat.Desktop.Windows</RootNamespace>
    <AssemblyName>Heartbeat.Desktop.Windows</AssemblyName>
    <ApplicationIcon>heartbeat.ico</ApplicationIcon>
    <StartupObject>Heartbeat.Desktop.Windows.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="heartbeat.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heartbeat.Agent\Heartbeat.Agent.csproj" />
    <ProjectReference Include="..\Heartbeat.Desktop.UI\Heartbeat.Desktop.UI.csproj" />
    <ProjectReference Include="..\Heartbeat.Desktop.Update\Heartbeat.Desktop.Update.csproj" />
  </ItemGroup>

</Project>
