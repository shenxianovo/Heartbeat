{
  "manifestVersion": 1,
  "packageId": "heartbeat.collector.system",
  "version": "1.1.1",
  "protocolMajors": [1],
  "supportedCapabilities": {
    "facts.segment": [1],
    "facts.event": [1],
    "diagnostics.stream-gap": [1]
  },
  "config": { "version": 1, "accepts": [1] },
  "observationDeclaration": {
    "document": "observation-depth.declaration.json"
  },
  "outputs": [
    {
      "outputId": "foreground",
      "source": "system",
      "factKind": "segment",
      "schema": {
        "id": "heartbeat.system.foreground-segment",
        "major": 1,
        "revision": 1,
        "document": "schemas/system-foreground-segment.schema.json"
      },
      "subjectKinds": ["machine"],
      "dimensionKeys": []
    },
    {
      "outputId": "input-events",
      "source": "system",
      "factKind": "event",
      "schema": {
        "id": "heartbeat.input",
        "major": 1,
        "revision": 1,
        "document": "schemas/system-input-event.schema.json"
      },
      "subjectKinds": ["machine"],
      "dimensionKeys": []
    }
  ],
  "artifacts": [
    {
      "artifactId": "system.inprocess",
      "selector": {
        "driver": "inProcess",
        "os": ["windows", "macos"],
        "arch": ["x64", "arm64"]
      },
      "entrypoint": "artifacts/system-collector.artifact.json"
    }
  ]
}
