<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Heartbeat.Desktop.Mac</RootNamespace>
    <AssemblyName>Heartbeat.Desktop.Mac</AssemblyName>
    <StartupObject>Heartbeat.Desktop.Mac.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\assets\heartbeat.ico" Link="heartbeat.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Heartbeat.Collector.System\Heartbeat.Collector.System.csproj" />
    <ProjectReference Include="..\Heartbeat.Desktop.UI\Heartbeat.Desktop.UI.csproj" />
    <ProjectReference Include="..\Heartbeat.Desktop.Updater.Velopack\Heartbeat.Desktop.Updater.Velopack.csproj" />
    <ProjectReference Include="..\..\hub\Heartbeat.Collection.Hub\Heartbeat.Collection.Hub.csproj" />
    <ProjectReference Include="..\..\..\shared\Heartbeat.Core\Heartbeat.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Heartbeat.Desktop.Mac.Tests" />
  </ItemGroup>
</Project>
