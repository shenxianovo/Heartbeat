<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Heartbeat.Desktop.UI.Controls"
        xmlns:presentation="using:Heartbeat.Desktop.UI.Presentation"
        x:Class="Heartbeat.Desktop.UI.Views.MainWindow"
        x:CompileBindings="False"
        Title="Heartbeat"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Shared product shell: native window chrome outside, Heartbeat identity inside. -->
    <Border x:Name="SidebarBorder" Grid.Column="0" Classes="sidebar"
            Width="176" ClipToBounds="True">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.18">
            <DoubleTransition.Easing>
              <CubicEaseOut />
            </DoubleTransition.Easing>
          </DoubleTransition>
        </Transitions>
      </Border.Transitions>
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,16,12,14">
        <Grid ColumnDefinitions="Auto,*" Margin="4,0,4,22">
          <Border Width="34" Height="34" CornerRadius="10"
                  Background="{DynamicResource HeartbeatPrimaryBrush}">
            <LucideIcon Kind="HeartPulse" Size="19" StrokeWidth="2"
                        Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="Heartbeat" Classes="brand sidebar-label" FontSize="16"
                     Margin="10,0,0,0" VerticalAlignment="Center"
                     Opacity="{Binding SidebarLabelOpacity}" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="5"
              HorizontalAlignment="Stretch">
          <Button Grid.Row="0" Classes="nav-item" Classes.active="{Binding IsOverviewSelected}"
                  Classes.compact="{Binding IsSidebarCollapsed}"
                  Command="{Binding NavigateCommand}" CommandParameter="Overview"
                  ToolTip.Tip="概览">
            <Grid ColumnDefinitions="28,*" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
              <Grid Grid.ColumnSpan="{Binding SidebarIconColumnSpan}"
                    Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <LucideIcon Kind="LayoutDashboard" Size="18" StrokeWidth="1.8"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1" Text="概览" Classes="sidebar-label" Margin="9,0,0,0"
                         VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" />
            </Grid>
          </Button>
          <Button Grid.Row="1" Classes="nav-item" Classes.active="{Binding IsCollectorsSelected}"
                  Classes.compact="{Binding IsSidebarCollapsed}"
                  Command="{Binding NavigateCommand}" CommandParameter="Collectors"
                  ToolTip.Tip="采集器">
            <Grid ColumnDefinitions="28,*" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
              <Grid Grid.ColumnSpan="{Binding SidebarIconColumnSpan}"
                    Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <LucideIcon Kind="Radio" Size="18" StrokeWidth="1.8"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1" Text="采集器" Classes="sidebar-label" Margin="9,0,0,0"
                         VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" />
            </Grid>
          </Button>
          <Button Grid.Row="2" Classes="nav-item" Classes.active="{Binding IsSettingsSelected}"
                  Classes.compact="{Binding IsSidebarCollapsed}"
                  Command="{Binding NavigateCommand}" CommandParameter="Settings"
                  ToolTip.Tip="设置">
            <Grid ColumnDefinitions="28,*" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
              <Grid Grid.ColumnSpan="{Binding SidebarIconColumnSpan}"
                    Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <LucideIcon Kind="Settings" Size="18" StrokeWidth="1.8"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Column="1" Text="设置" Classes="sidebar-label" Margin="9,0,0,0"
                         VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" />
            </Grid>
          </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="10,0"
              ToolTip.Tip="关闭窗口不会停止采集">
            <Border Grid.ColumnSpan="{Binding SidebarIconColumnSpan}"
                    Width="8" Height="8" CornerRadius="4" HorizontalAlignment="Center"
                    Background="{DynamicResource HeartbeatSuccessBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="运行中" Classes="sidebar-label" Margin="9,0,0,0"
                       FontWeight="SemiBold" FontSize="12"
                       Opacity="{Binding SidebarLabelOpacity}" />
        </Grid>
      </Grid>
    </Border>

    <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedPageIndex}"
              IsSwipeEnabled="False">
      <Carousel.PageTransition>
        <CrossFade Duration="0:0:0.16" />
      </Carousel.PageTransition>

    <!-- Overview -->
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,26" Spacing="12">
          <TextBlock Text="概览" Classes="page-title" Margin="2,0,0,2" />

          <Border Classes="surface">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="当前活动" Classes="eyebrow" />
                <TextBlock Text="{Binding CurrentApp}" FontSize="24" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentActivityDetail}" Classes="muted" />
              </StackPanel>
              <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Width="8" Height="8" CornerRadius="4"
                          Background="{DynamicResource HeartbeatSuccessBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="正常运行" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding OperationalNotices}"
                        IsVisible="{Binding HasOperationalNotices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="notice" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <LucideIcon Kind="TriangleAlert" Size="19" StrokeWidth="1.8"
                                Foreground="{DynamicResource HeartbeatWarningBrush}"
                                Margin="1,1,12,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
                      <TextBlock Text="{Binding Action}" IsVisible="{Binding HasAction}"
                                 Foreground="{DynamicResource HeartbeatWarningBrush}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Path}" IsVisible="{Binding HasPath}"
                                 Classes="subtle" FontSize="10" FontFamily="SF Mono,Cascadia Code,Consolas,monospace"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="surface compact" IsVisible="{Binding HasAvailableUpdate}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="36" Height="36" CornerRadius="11"
                      Background="{DynamicResource HeartbeatPrimarySoftBrush}">
                <LucideIcon Kind="RefreshCw" Size="18" StrokeWidth="1.8"
                            Foreground="{DynamicResource HeartbeatPrimaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,14,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateStateText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpdateStateDetail}" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding UpdateError}" IsVisible="{Binding HasUpdateError}"
                           Foreground="{DynamicResource HeartbeatDangerBrush}" FontSize="11" />
                <TextBlock Text="{Binding UpdateCheckMessage}" IsVisible="{Binding HasUpdateCheckMessage}"
                           Classes="muted" FontSize="11" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="应用并重启" Classes="primary" Command="{Binding ApplyUpdateCommand}"
                        IsVisible="{Binding IsUpdateReady}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Collectors -->
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,26" Spacing="12">
          <TextBlock Text="采集器" Classes="page-title" Margin="2,0,0,2" />

          <ItemsControl ItemsSource="{Binding Collectors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <controls:SettingsExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                             IsVisible="{Binding IsSystem}"
                                             Header="{Binding Source}"
                                             Description="{Binding Summary}"
                                             ItemsSource="{Binding Capabilities}">
                    <controls:SettingsExpander.HeaderIcon>
                      <Border Width="38" Height="38" CornerRadius="10"
                              Background="{DynamicResource HeartbeatPrimarySoftBrush}">
                        <LucideIcon Kind="MonitorCog" Size="19" StrokeWidth="1.7"
                                    Foreground="{DynamicResource HeartbeatPrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.ActionContent>
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="内置" FontSize="10" Classes="subtle" VerticalAlignment="Center" />
                        <Border Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource HeartbeatSuccessBrush}"
                                IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActivityText}" FontSize="10" Classes="muted"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </controls:SettingsExpander.ActionContent>
                    <controls:SettingsExpander.ItemTemplate>
                      <DataTemplate>
                        <controls:SettingsCard IsNested="True" Header="{Binding Name}">
                          <controls:SettingsCard.HeaderIcon>
                            <Grid Width="38" Height="38">
                              <Border Width="8" Height="8" CornerRadius="4"
                                      Background="{DynamicResource HeartbeatSuccessBrush}"
                                      IsVisible="{Binding IsEffective}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Border Width="8" Height="8" CornerRadius="4"
                                      Background="{DynamicResource HeartbeatSubtleBrush}"
                                      IsVisible="{Binding IsIneffective}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                          </controls:SettingsCard.HeaderIcon>
                          <controls:SettingsCard.Description>
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding PermissionHelpText}"
                                         IsVisible="{Binding HasPermissionHelp}"
                                         Foreground="{DynamicResource HeartbeatWarningBrush}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </controls:SettingsCard.Description>
                          <controls:SettingsCard.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11"
                                         VerticalAlignment="Center" />
                              <Button Content="去授权" Classes="primary"
                                      IsVisible="{Binding ShowRecoveryAction}"
                                      Command="{Binding RecoverCommand}" />
                              <Button Content="显示位置" Classes="ghost"
                                      IsVisible="{Binding ShowApplicationLocationAction}"
                                      Command="{Binding RevealApplicationCommand}" />
                              <ToggleSwitch IsVisible="{Binding HasToggle}"
                                            IsChecked="{Binding RequestedEnabled}" />
                            </StackPanel>
                          </controls:SettingsCard.ActionContent>
                        </controls:SettingsCard>
                      </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                  </controls:SettingsExpander>

                  <Border Classes="settings-card browser-card" IsVisible="{Binding IsBrowser}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource HeartbeatPrimarySoftBrush}">
                          <LucideIcon Kind="Globe" Size="19" StrokeWidth="1.7"
                                      Foreground="{DynamicResource HeartbeatPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,18,0" Spacing="4"
                                    VerticalAlignment="Center">
                          <TextBlock Text="浏览器活动" FontSize="14" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="7" Height="7" CornerRadius="4"
                                    Background="{DynamicResource HeartbeatSuccessBrush}"
                                    IsVisible="{Binding IsBrowserReady}" VerticalAlignment="Center" />
                            <Border Width="7" Height="7" CornerRadius="4"
                                    Background="{DynamicResource HeartbeatWarningBrush}"
                                    IsVisible="{Binding IsBrowserDegraded}" VerticalAlignment="Center" />
                            <Border Width="7" Height="7" CornerRadius="4"
                                    Background="{DynamicResource HeartbeatSubtleBrush}"
                                    IsVisible="{Binding IsBrowserWaiting}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BrowserStatusText}" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Text="·" Classes="subtle" />
                            <TextBlock Text="{Binding BrowserStatusDetail}" Classes="muted" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                                    VerticalAlignment="Center">
                          <Button Classes="ghost browser-config-toggle"
                                  ToolTip.Tip="配置浏览器采集器"
                                  Command="{Binding ToggleBrowserConfigurationCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <LucideIcon Kind="Settings2" Size="15" StrokeWidth="1.8" />
                              <TextBlock Text="配置" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <ToggleSwitch IsChecked="{Binding Enabled}"
                                        ToolTip.Tip="启用或停用浏览器活动采集" />
                        </StackPanel>
                      </Grid>

                      <Border Grid.Row="1" Classes="browser-configuration"
                              IsVisible="{Binding IsBrowserConfigurationExpanded}" Margin="50,12,0,0">
                        <StackPanel Spacing="9">
                          <StackPanel Spacing="2">
                            <TextBlock Text="连接浏览器" FontWeight="SemiBold" />
                            <TextBlock Text="选择浏览器后会打开扩展管理页，并复制采集器目录。"
                                       Classes="muted" FontSize="11" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Brand glyphs from Simple Icons 10.4.0 (CC0-1.0). -->
                            <Button Classes="browser-choice" ToolTip.Tip="在 Chrome 中添加浏览器采集器"
                                    Command="{Binding OpenBrowserSetupCommand}"
                                    CommandParameter="{x:Static presentation:BrowserKind.Chrome}">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Classes="browser-brand-icon" Width="20" Height="20"
                                          Foreground="#4285F4"
                                          Data="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z" />
                                <TextBlock Text="Google Chrome" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                            <Button Classes="browser-choice" ToolTip.Tip="在 Edge 中添加浏览器采集器"
                                    Command="{Binding OpenBrowserSetupCommand}"
                                    CommandParameter="{x:Static presentation:BrowserKind.Edge}">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Classes="browser-brand-icon" Width="20" Height="20"
                                          Foreground="#0C59A4"
                                          Data="M21.86 17.86q.14 0 .25.12.1.13.1.25t-.11.33l-.32.46-.43.53-.44.5q-.21.25-.38.42l-.22.23q-.58.53-1.34 1.04-.76.51-1.6.91-.86.4-1.74.64t-1.67.24q-.9 0-1.69-.28-.8-.28-1.48-.78-.68-.5-1.22-1.17-.53-.66-.92-1.44-.38-.77-.58-1.6-.2-.83-.2-1.67 0-1 .32-1.96.33-.97.87-1.8.14.95.55 1.77.41.82 1.02 1.5.6.68 1.38 1.21.78.54 1.64.9.86.36 1.77.56.92.2 1.8.2 1.12 0 2.18-.24 1.06-.23 2.06-.72l.2-.1.2-.05zm-15.5-1.27q0 1.1.27 2.15.27 1.06.78 2.03.51.96 1.24 1.77.74.82 1.66 1.4-1.47-.2-2.8-.74-1.33-.55-2.48-1.37-1.15-.83-2.08-1.9-.92-1.07-1.58-2.33T.36 14.94Q0 13.54 0 12.06q0-.81.32-1.49.31-.68.83-1.23.53-.55 1.2-.96.66-.4 1.35-.66.74-.27 1.5-.39.78-.12 1.55-.12.7 0 1.42.1.72.12 1.4.35.68.23 1.32.57.63.35 1.16.83-.35 0-.7.07-.33.07-.65.23v-.02q-.63.28-1.2.74-.57.46-1.05 1.04-.48.58-.87 1.26-.38.67-.65 1.39-.27.71-.42 1.44-.15.72-.15 1.38zM11.96.06q1.7 0 3.33.39 1.63.38 3.07 1.15 1.43.77 2.62 1.93 1.18 1.16 1.98 2.7.49.94.76 1.96.28 1 .28 2.08 0 .89-.23 1.7-.24.8-.69 1.48-.45.68-1.1 1.22-.64.53-1.45.88-.54.24-1.11.36-.58.13-1.16.13-.42 0-.97-.03-.54-.03-1.1-.12-.55-.1-1.05-.28-.5-.19-.84-.5-.12-.09-.23-.24-.1-.16-.1-.33 0-.15.16-.35.16-.2.35-.5.2-.28.36-.68.16-.4.16-.95 0-1.06-.4-1.96-.4-.91-1.06-1.64-.66-.74-1.52-1.28-.86-.55-1.79-.89-.84-.3-1.72-.44-.87-.14-1.76-.14-1.55 0-3.06.45T.94 7.55q.71-1.74 1.81-3.13 1.1-1.38 2.52-2.35Q6.68 1.1 8.37.58q1.7-.52 3.58-.52Z" />
                                <TextBlock Text="Microsoft Edge" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <Border Grid.Row="2" Classes="browser-setup"
                              IsVisible="{Binding IsBrowserSetupVisible}" Margin="50,8,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                          <LucideIcon Kind="MousePointerClick" Size="18" StrokeWidth="1.8"
                                      Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding BrowserSetupTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="扩展管理页已经打开，目录也已复制。开启开发者模式，点击“加载已解压的扩展程序”，粘贴或选择下面的目录。"
                                       TextWrapping="Wrap" Classes="muted" FontSize="11" />
                            <SelectableTextBlock Text="{Binding SideloadDirectory}"
                                                 FontFamily="SF Mono,Cascadia Code,Consolas,monospace"
                                                 FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BrowserSetupError}"
                                       IsVisible="{Binding HasBrowserSetupError}"
                                       Foreground="{DynamicResource HeartbeatDangerBrush}"
                                       TextWrapping="Wrap" FontSize="11" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <StackPanel Grid.Row="3" Margin="50,8,0,0" Spacing="7">
                        <Button Content="{Binding BrowserDetailsToggleText}"
                                Classes="ghost diagnostic-toggle" HorizontalAlignment="Left"
                                Command="{Binding ToggleBrowserDetailsCommand}" />
                        <Border Classes="browser-diagnostics"
                                IsVisible="{Binding IsBrowserDetailsExpanded}">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding PackageVersionText}" />
                            <TextBlock Text="{Binding RuntimeStatusDetail}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding SideloadDirectory}"
                                                 IsVisible="{Binding HasSideloadDirectory}"
                                                 FontFamily="SF Mono,Cascadia Code,Consolas,monospace"
                                                 FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviousKnownGoodText}"
                                       IsVisible="{Binding HasPreviousKnownGood}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <controls:SettingsCard IsVisible="{Binding IsNotBrowser}"
                                         Header="{Binding Source}">
                    <controls:SettingsCard.HeaderIcon>
                      <Border Width="38" Height="38" CornerRadius="10"
                              Background="{DynamicResource HeartbeatPrimarySoftBrush}">
                        <LucideIcon Kind="Radio" Size="19" StrokeWidth="1.7"
                                    Foreground="{DynamicResource HeartbeatPrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.ActionContent>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource HeartbeatSuccessBrush}"
                                IsVisible="{Binding IsActive}" />
                        <Border Width="7" Height="7" CornerRadius="4"
                                Background="{DynamicResource HeartbeatSubtleBrush}"
                                IsVisible="{Binding IsInactive}" />
                        <TextBlock Text="{Binding ActivityText}" FontSize="10" Classes="muted"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding Enabled}" />
                      </StackPanel>
                    </controls:SettingsCard.ActionContent>
                  </controls:SettingsCard>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Settings -->
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Text="设置" Classes="page-title" Margin="26,22,24,8" />

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,22" Spacing="4">
          <TextBlock Text="连接" Classes="settings-section-title" />

          <controls:SettingsCard Header="API Key" Description="上传数据所需的访问凭证">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="Key" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <Grid ColumnDefinitions="*,Auto" Width="300" VerticalAlignment="Center">
                <TextBox Text="{Binding ApiKey}" PasswordChar="●"
                         IsVisible="{Binding IsApiKeyHidden}" />
                <TextBox Text="{Binding ApiKey}" IsVisible="{Binding IsApiKeyVisible}" />
                <Button Grid.Column="1" Classes="ghost icon-button" Margin="7,0,0,0"
                        Command="{Binding ToggleApiKeyVisibilityCommand}" ToolTip.Tip="显示或隐藏 API Key">
                  <Grid>
                    <LucideIcon Kind="EyeClosed" Size="17" IsVisible="{Binding IsApiKeyHidden}" />
                    <LucideIcon Kind="EyeOff" Size="17" IsVisible="{Binding IsApiKeyVisible}" />
                  </Grid>
                </Button>
              </Grid>
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <controls:SettingsCard Header="设备名称" Description="在 Dashboard 与报表中显示">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="Monitor" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <TextBox Text="{Binding DeviceName}" Width="300" />
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <controls:SettingsCard Header="上传间隔" Description="控制本地数据提交频率，必须为正整数">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="Clock" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding UploadIntervalMinutes}" Width="90" />
                <TextBlock Text="分钟" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <TextBlock Text="通用" Classes="settings-section-title" />

          <controls:SettingsCard Header="登录时启动" Description="登录系统后自动启动并继续后台采集">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="Power" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <ToggleSwitch IsChecked="{Binding LoginStartEnabled}" />
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <controls:SettingsCard Header="主题" Description="选择 Heartbeat 的界面外观">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="Palette" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" Width="130">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
              </ComboBox>
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <TextBlock Text="维护" Classes="settings-section-title" />

          <controls:SettingsCard Header="软件更新"
                                 Description="{Binding UpdateStateDetail}"
                                 IsVisible="{Binding UpdatesSupported}">
            <controls:SettingsCard.HeaderIcon>
              <LucideIcon Kind="RefreshCw" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionContent>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding UpdateStateText}" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding UpdateError}" IsVisible="{Binding HasUpdateError}"
                             Foreground="{DynamicResource HeartbeatDangerBrush}" FontSize="11" />
                  <TextBlock Text="{Binding UpdateCheckMessage}" IsVisible="{Binding HasUpdateCheckMessage}"
                             Classes="muted" FontSize="11" />
                </StackPanel>
                <Button Content="检查更新" Classes="ghost" Command="{Binding CheckForUpdateCommand}" />
                <Button Content="应用并重启" Classes="primary" Command="{Binding ApplyUpdateCommand}"
                        IsVisible="{Binding IsUpdateReady}" />
              </StackPanel>
            </controls:SettingsCard.ActionContent>
          </controls:SettingsCard>

          <controls:SettingsExpander Header="诊断"
                                     Description="调整日志级别并查看实时日志"
                                     IsExpanded="{Binding IsDiagnosticsExpanded, Mode=TwoWay}">
            <controls:SettingsExpander.HeaderIcon>
              <LucideIcon Kind="Logs" Size="19" StrokeWidth="1.8"
                          Foreground="{DynamicResource HeartbeatPrimaryBrush}" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.ItemsHeader>
              <StackPanel Spacing="9" Margin="15">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button Content="DBG" Classes="ghost" Padding="8,4"
                          Command="{Binding SetLogLevelCommand}" CommandParameter="Debug" />
                  <Button Content="INF" Classes="ghost" Padding="8,4"
                          Command="{Binding SetLogLevelCommand}" CommandParameter="Information" />
                  <Button Content="WRN" Classes="ghost" Padding="8,4"
                          Command="{Binding SetLogLevelCommand}" CommandParameter="Warning" />
                  <Button Content="ERR" Classes="ghost" Padding="8,4"
                          Command="{Binding SetLogLevelCommand}" CommandParameter="Error" />
                </StackPanel>
                <Border Height="200" Classes="log-viewer">
                  <controls:TailScrollViewer IsVisible="{Binding IsDiagnosticsExpanded}"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsScrollChainingEnabled="False">
                    <SelectableTextBlock Text="{Binding LogText}" TextWrapping="NoWrap"
                                         Margin="12" Classes="log-text" />
                  </controls:TailScrollViewer>
                </Border>
              </StackPanel>
            </controls:SettingsExpander.ItemsHeader>
          </controls:SettingsExpander>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource HeartbeatSurfaceBrush}"
              BorderBrush="{DynamicResource HeartbeatBorderBrush}" BorderThickness="0,1,0,0"
              Padding="24,10" IsVisible="{Binding ShowSaveBar}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="有未保存的更改" IsVisible="{Binding HasUnsavedChanges}"
                       Classes="muted" />
            <TextBlock Text="{Binding SaveStatusMessage}" IsVisible="{Binding ShowSaveSuccess}"
                       Foreground="{DynamicResource HeartbeatSuccessBrush}" />
            <TextBlock Text="{Binding SaveStatusMessage}" IsVisible="{Binding ShowSaveError}"
                       Foreground="{DynamicResource HeartbeatDangerBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Command="{Binding SaveConfigCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <LucideIcon Kind="Save" Size="16" StrokeWidth="1.8" />
              <TextBlock Text="保存更改" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
    </Carousel>
  </Grid>
</Window>
