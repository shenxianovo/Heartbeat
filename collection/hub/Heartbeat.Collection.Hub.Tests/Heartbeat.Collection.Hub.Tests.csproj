<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heartbeat.Collection.Hub\Heartbeat.Collection.Hub.csproj" />
    <ProjectReference Include="..\..\collectors\Heartbeat.Collector.Reference.ManagedProcess\Heartbeat.Collector.Reference.ManagedProcess.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\collectors\Heartbeat.Collector.VRChat\Heartbeat.Collector.VRChat.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyManagedReferenceCollector" AfterTargets="Build">
    <ItemGroup>
      <ManagedReferenceCollectorFiles Include="..\..\collectors\Heartbeat.Collector.Reference.ManagedProcess\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ManagedReferenceCollectorFiles)"
          DestinationFiles="@(ManagedReferenceCollectorFiles->'$(OutDir)Fixtures/ManagedReferenceCollector/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyManagedVRChatCollector" AfterTargets="Build">
    <ItemGroup>
      <ManagedVRChatCollectorFiles Include="..\..\collectors\Heartbeat.Collector.VRChat\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ManagedVRChatCollectorFiles)"
          DestinationFiles="@(ManagedVRChatCollectorFiles->'$(OutDir)Fixtures/ManagedVRChatCollector/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\collectors\Heartbeat.Collector.Browser\Package\**\*">
      <Link>Fixtures\BrowserCollectorPackage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
