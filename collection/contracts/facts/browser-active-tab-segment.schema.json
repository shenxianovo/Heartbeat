  "payloadSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["identityKey", "title", "attributes"],
    "properties": {
      "identityKey": { "type": "string", "minLength": 1 },
      "title": { "type": "string" },
      "attributes": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "domain", "site", "windowId"],
        "properties": {
          "url": { "type": "string" },
          "domain": { "type": "string" },
          "site": { "type": "string" },
          "windowId": { "type": "integer" }
        }
      }
    }
  }
}
