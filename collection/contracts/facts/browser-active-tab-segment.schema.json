{
  "documentVersion": 1,
  "schemaId": "heartbeat.browser.active-tab-segment",
  "schemaMajor": 1,
  "schemaRevision": 1,
  "factKind": "segment",
  "evolution": { "mode": "segmentSnapshot", "allowRetraction": true },
