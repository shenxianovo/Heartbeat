<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos27.0</TargetFramework>
    <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationTitle>Heartbeat Dev</ApplicationTitle>
    <ApplicationId>com.shenxianovo.heartbeat.desktop</ApplicationId>
    <!-- The Collector assembly also has a standalone CLI; this host uses only its library types. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <LinkMode>None</LinkMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Heartbeat.Desktop/Heartbeat.Desktop.csproj" />
    <ProjectReference Include="../../Collectors/Heartbeat.Collector.Desktop.Mac/Heartbeat.Collector.Desktop.Mac.csproj" />
  </ItemGroup>
</Project>
