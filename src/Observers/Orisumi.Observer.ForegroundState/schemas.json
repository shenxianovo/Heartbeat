[
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000003",
    "content": {
      "displayName": "前台状态 Observer",
      "description": "表示一个前台状态 Observer 程序实例，保存它运行的平台、主机名和程序版本；它作为 Observer 对前台应用时段和窗口标题时段的观测负责。",
      "resourceName": "foreground-state-observers",
      "fields": {
        "platform": {
          "type": "string",
          "description": "运行的平台：macos、windows、android 或 linux",
          "nullable": false,
          "required": true
        },
        "hostName": {
          "type": "string",
          "description": "本机的名称，读不到时为 null",
          "nullable": true,
          "required": true
        },
        "programVersion": {
          "type": "string",
          "description": "程序的版本，即安装包的版本",
          "nullable": false,
          "required": true
        }
      }
    }
  },
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000002",
    "content": {
      "displayName": "本机应用",
      "description": "表示某台设备上的一个应用安装，保存用于识别安装的平台标识线索。",
      "resourceName": "local-applications",
      "fields": {
        "deviceVersionId": {
          "type": "reference",
          "description": "应用所在的设备",
          "nullable": false,
          "required": true
        },
        "identifiers": {
          "type": "array",
          "description": "平台标识线索，顺序无意义；没有线索时为 []",
          "nullable": false,
          "required": true,
          "items": {
            "type": "object",
            "description": "一项平台标识线索，由 scheme 和 value 共同解释",
            "nullable": false,
            "fields": {
              "scheme": {
                "type": "string",
                "description": "线索的种类：macos.bundle-id 是应用包标识，macos.executable-path 是可执行文件路径，android.package-name 是 Android 应用的包名",
                "nullable": false,
                "required": true
              },
              "value": {
                "type": "string",
                "description": "线索的原始值",
                "nullable": false,
                "required": true
              }
            }
          }
        }
      }
    }
  },
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000001",
    "content": {
      "displayName": "前台应用时段",
      "description": "表达某个本机应用连续处于前台的一段活动，每段活动一个实体；内容保存应用引用与时段开始时读到的名称和图标，Observation 保存时段。",
      "resourceName": "foreground-application-periods",
      "fields": {
        "localApplicationVersionId": {
          "type": "reference",
          "description": "观测设备上的本机应用",
          "nullable": false,
          "required": true
        },
        "name": {
          "type": "string",
          "description": "当时读到的应用名称，没读到时为 null",
          "nullable": true,
          "required": true
        },
        "icon": {
          "type": "binary",
          "description": "时段开始时读到的应用图标，1024×1024 像素的 PNG；没读到时为 null",
          "nullable": true,
          "required": true
        }
      }
    }
  }
]
