[
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000005",
    "content": {
      "displayName": "应用识别 Observer",
      "description": "表示一个应用识别 Observer 程序实例，保存它的程序版本和调用的模型；它作为 Observer 对它写入的线索归属负责。",
      "resourceName": "application-identity-observers",
      "fields": {
        "programVersion": {
          "type": "string",
          "description": "程序的版本",
          "nullable": false,
          "required": true
        },
        "model": {
          "type": "string",
          "description": "判断时调用的模型，写作供应商和型号，例如 openai/gpt-5-mini",
          "nullable": false,
          "required": true
        }
      },
      "kind": "observation",
      "immutable": false
    }
  },
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000004",
    "content": {
      "displayName": "应用产品",
      "description": "表示用户认知中的一款软件。名字是 Name，属于它的线索是线索归属。",
      "resourceName": "application-products",
      "fields": {},
      "kind": "thing",
      "immutable": false
    }
  },
  {
    "schemaId": "019e1bbb-ec00-7000-8000-00000000000c",
    "content": {
      "displayName": "线索归属",
      "description": "表示一条跨设备线索属于一个应用产品。一条线索一个实体；本机应用的跨设备线索有线索归属时，它属于线索归属指向的产品。",
      "resourceName": "application-memberships",
      "fields": {
        "identifierId": {
          "type": "reference",
          "description": "一条应用线索",
          "required": true,
          "nullable": false,
          "target": "thing"
        },
        "productId": {
          "type": "reference",
          "description": "线索属于的应用产品",
          "required": true,
          "nullable": false,
          "target": "thing"
        }
      },
      "kind": "observation",
      "immutable": true
    }
  }
]
