<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The API serves no static files. SDK 10.0.401 dotnet watch fails to read staticwebassets.development.json on macOS and Linux
         (path separator bug, fixed upstream in https://github.com/dotnet/sdk/pull/54536). Re-enable with an SDK that has the fix. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orisumi.Integration.Tests" />
    <ProjectReference Include="../Orisumi.Application/Orisumi.Application.csproj" />
    <ProjectReference Include="../Orisumi.Infrastructure/Orisumi.Infrastructure.csproj" />
  </ItemGroup>
</Project>
