            }
          },
          "413": {
            "description": "请求体超过 10 MiB。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getObservationDraft",
        "summary": "读取观测草稿",
        "description": "读取一份 Observation 暂存的草稿，见 [API · 观测草稿](/api#drafts)。",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "Observation 的 EntityId。",
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "暂存的草稿。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationDraft"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "这份 Observation 没有暂存的草稿。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/observation-drafts": {
      "get": {
        "operationId": "listObservationDrafts",
        "summary": "列出观测草稿",
        "description": "按 EntityId 升序列出全部暂存的草稿，不分页，见 [API · 观测草稿](/api#drafts)。",
        "parameters": [
          {
            "name": "resourceName",
            "in": "query",
            "required": false,
            "description": "观测内容的资源名。只返回观测内容属于这种业务类型的草稿。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "暂存的草稿。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationDraftList"
                }
              }
            }
          },
          "400": {
            "description": "参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "没有 EntitySchema 使用这个 `resourceName`。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EntityId": {
        "type": "string",
        "format": "uuid",
        "description": "写入方生成的 UUIDv7，见 [ENTITY-2](/core/model/entity#entity-2)。"
      },
      "VersionId": {
        "type": "string",
        "format": "uuid",
        "description": "写入方生成的 UUIDv7，见 [VERSION-12](/core/model/version#version-12)。"
      },
      "Category": {
        "type": "string",
        "enum": [
          "observation",
          "entity_schema",
          "input_set",
          "business"
        ],
        "description": "版本内容属于哪一类。前三种是 Core 类型。"
      },
      "VersionSubmission": {
        "type": "object",
        "description": "提交的一个版本。成员的含义见 [Version](/core/model/version#members)。`recordedAt` 由后端赋值，提交时不得出现，见 [VERSION-10](/core/model/version#version-10)。 请求结构按 category 选择 content。结构通过后仍逐个校验 Core 规则；两阶段的拒绝范围见 [API · 校验阶段](/api#validation)。",
        "required": [
          "entityId",
          "versionId",
          "previousVersionId",
          "category",
          "schemaVersionId",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "entityId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "versionId": {
            "$ref": "#/components/schemas/VersionId"
          },
          "previousVersionId": {
            "description": "同一实体的前一版本，首版为 `null`。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "schemaVersionId": {
            "description": "业务内容所用的 Schema 版本，Core 类型为 `null`。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "$ref": "#/components/schemas/Content"
          }
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "observation"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/Observation"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "entity_schema"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/EntitySchema"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "input_set"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/InputSet"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "business"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/BusinessContent"
              }
            },
            "required": [
              "category",
              "content"
            ]
          }
        ]
      },
      "Version": {
        "type": "object",
        "description": "一个已保存的版本。成员的含义见 [Version](/core/model/version#members)。",
        "required": [
          "entityId",
          "versionId",
          "previousVersionId",
          "category",
          "schemaVersionId",
          "recordedAt",
          "content"
        ],
        "properties": {
          "entityId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "versionId": {
            "$ref": "#/components/schemas/VersionId"
          },
          "previousVersionId": {
            "description": "同一实体的前一版本，首版为 `null`。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "schemaVersionId": {
            "description": "业务内容所用的 Schema 版本，Core 类型为 `null`。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "后端首次保存这个版本的时刻，以 `Z` 结尾，见 [VERSION-10](/core/model/version#version-10)。"
          },
          "content": {
            "$ref": "#/components/schemas/Content"
          }
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "observation"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/Observation"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "entity_schema"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/EntitySchema"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "input_set"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/InputSet"
              }
            },
            "required": [
              "category",
              "content"
            ]
          },
          {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "business"
                ]
              },
              "content": {
                "$ref": "#/components/schemas/BusinessContent"
              }
            },
            "required": [
              "category",
              "content"
            ]
          }
        ]
      },
      "Content": {
        "description": "版本的内容，按 `category` 解释：Core 类型的成员见各类型页，业务内容按 `schemaVersionId` 指向的 Schema 版本校验。",
        "anyOf": [
          {
            "$ref": "#/components/schemas/Observation"
          },
          {
            "$ref": "#/components/schemas/InputSet"
          },
          {
            "$ref": "#/components/schemas/EntitySchema"
          },
          {
            "$ref": "#/components/schemas/BusinessContent"
          }
        ]
      },
      "Observation": {
        "type": "object",
        "description": "Observation 的成员，见 [Observation](/core/model/observation#members)。",
        "required": [
          "observerVersionId",
          "contentVersionId",
          "inputSetVersionId",
          "startAt",
          "endAt",
          "timeZone"
        ],
        "additionalProperties": false,
        "properties": {
          "observerVersionId": {
            "$ref": "#/components/schemas/VersionId"
          },
          "contentVersionId": {
            "$ref": "#/components/schemas/VersionId"
          },
          "inputSetVersionId": {
            "description": "这次处理用到的 InputSet，没有用到已保存的数据时为 `null`。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "startAt": {
            "description": "事实的已知开始边界，未知时为 `null`。",
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "endAt": {
            "description": "事实的已知结束边界，未知时为 `null`。",
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeZone": {
            "description": "事实所属的 IANA 时区，未知时为 `null`。",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InputSet": {
        "type": "object",
        "description": "InputSet 的成员，见 [InputSet](/core/model/input-set#members)。",
        "required": [
          "members"
        ],
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionId"
            },
            "description": "这次处理用到的版本，非空、不重复、无序，见 [INPUTSET-2](/core/model/input-set#inputset-2)、[INPUTSET-3](/core/model/input-set#inputset-3)、[INPUTSET-4](/core/model/input-set#inputset-4)。 此处只检查数组与成员的结构；非空、去重由 Core 逐项检查，违反时带 index，不拒绝整批。"
          }
        }
      },
      "EntitySchema": {
        "type": "object",
        "description": "一个 Schema 版本，见 [EntitySchema](/core/model/schema)。",
        "required": [
          "displayName",
          "description",
          "resourceName",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "description": "类型名称，见 [SCHEMA-4](/core/model/schema#schema-4)。"
          },
          "description": {
            "type": "string",
            "description": "业务说明，见 [SCHEMA-4](/core/model/schema#schema-4)。"
          },
          "resourceName": {
            "type": "string",
            "description": "类型的资源名，见 [SCHEMA-5](/core/model/schema#schema-5)、[SCHEMA-6](/core/model/schema#schema-6)。"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldDefinition"
            },
            "description": "字段名到字段定义的映射。"
          }
        }
      },
      "FieldDefinition": {
        "type": "object",
        "description": "一个字段或数组元素的定义，见 [EntitySchema · 字段定义](/core/model/schema#field-definitions)和 [SCHEMA-10](/core/model/schema#schema-10) 到 [SCHEMA-14](/core/model/schema#schema-14)。 这里声明整批请求检查的配置值类型；必写项（含 description）、未知配置和类型间的约束由 SCHEMA-10、SCHEMA-12、SCHEMA-14 逐项检查，不在此处设置 required 或 additionalProperties: false。",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "boolean",
              "integer",
              "number",
              "reference",
              "object",
              "array"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "nullable": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldDefinition"
            }
          },
          "items": {
            "$ref": "#/components/schemas/FieldDefinition"
          },
          "description": {
            "type": "string",
            "description": "字段或数组元素的业务说明，必须非空且不全为空白。必填与非空由 SCHEMA-10 逐项校验；缺失或空白不作为整批请求的结构错误。"
          }
        }
      },
      "BusinessContent": {
        "type": "object",
        "description": "业务字段，按 `schemaVersionId` 指向的 Schema 版本校验，见 [SCHEMA-2](/core/model/schema#schema-2)。"
      },
      "SubmissionRequest": {
        "type": "object",
        "required": [
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/VersionSubmission"
            },
            "description": "按依赖顺序排列的版本。"
          }
        }
      },
      "SubmissionResult": {
        "type": "object",
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "description": "每个版本的结果，顺序与提交相同。",
            "items": {
              "type": "object",
              "required": [
                "versionId",
                "recordedAt"
              ],
              "properties": {
                "versionId": {
                  "$ref": "#/components/schemas/VersionId"
                },
                "recordedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "首次保存这个版本的时刻。重试的版本返回首次保存时的值。"
                }
              }
            }
          }
        }
      },
      "VersionList": {
        "type": "object",
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          }
        }
      },
      "VersionPage": {
        "type": "object",
        "required": [
          "versions",
          "next"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          },
          "next": {
            "description": "下一页的游标，作为 `after` 传入。没有下一页时为 `null`。",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object",
        "properties": {
          "type": {
            "const": "about:blank",
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "rule": {
