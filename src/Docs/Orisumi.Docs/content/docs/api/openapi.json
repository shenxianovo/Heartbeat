{
  "openapi": "3.1.1",
  "info": {
    "title": "Orisumi API",
    "description": "Orisumi HTTP 接口契约。维护者直接修改此文件。文档站读取此文件展示接口，后端按契约实现。\n\n接口按 Core 的实体与版本模型定义。共用的约定见 API Overview。",
    "version": "draft"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/versions": {
      "post": {
        "operationId": "submitVersions",
        "summary": "提交版本",
        "description": "按数组顺序逐个保存版本，见 [VERSION-13](/core/model/version#version-13)。已保存的 VersionId 再次提交时，内容相同就视为已保存，见 [VERSION-7](/core/model/version#version-7)。某个版本被拒绝时，后面的版本不再处理，前面已保存的版本保留；错误响应的 `index` 和 `versionId` 指出被拒绝的版本。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionRequest"
              },
              "example": {
                "versions": [
                  {
                    "entityId": "019e1bbb-ec00-7000-8000-00000000e001",
                    "versionId": "019e1bbb-ec00-7000-8000-00000000f001",
                    "previousVersionId": null,
                    "category": "entity_schema",
                    "schemaVersionId": null,
                    "content": {
                      "displayName": "示例条目",
                      "description": "Playground 的示例类型，每条记下一个标题。",
                      "resourceName": "example-items",
                      "fields": {
                        "title": {
                          "type": "string",
                          "required": true,
                          "nullable": true,
                          "description": "条目的标题。"
                        }
                      }
                    }
                  },
                  {
                    "entityId": "019e1bbb-ec00-7000-8000-00000000e002",
                    "versionId": "019e1bbb-ec00-7000-8000-00000000f002",
                    "previousVersionId": null,
                    "category": "business",
                    "schemaVersionId": "019e1bbb-ec00-7000-8000-00000000f001",
                    "content": {
                      "title": "第一条"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "全部版本都已保存。结果的顺序与提交相同。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                }
              }
            }
          },
          "400": {
            "description": "请求体不符合契约时，整次提交都不处理，响应中没有 `rule` 和 `index`。某个版本违反 Core 规则时，`rule` 是规则编号，`index` 和 `versionId` 指出这个版本。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionProblem"
                }
              }
            }
          },
          "409": {
            "description": "某个版本与已保存的数据冲突：基于旧版本（[VERSION-6](/core/model/version#version-6)）、重试的内容不同（[VERSION-7](/core/model/version#version-7)）、资源名已被占用（[SCHEMA-5](/core/model/schema#schema-5)）、实体已被删除（[HISTORY-7](/core/rules/history#history-7)）或 VersionId 属于已删除的实体（[VERSION-9](/core/model/version#version-9)）。`rule`、`index` 和 `versionId` 指出原因和版本。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionProblem"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过 10 MiB。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/versions/{versionId}": {
      "get": {
        "operationId": "getVersion",
        "summary": "读取版本",
        "description": "按 VersionId 读取一个版本，所有类型的版本都用这个接口。",
        "parameters": [
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "description": "版本的 VersionId。",
            "schema": {
              "$ref": "#/components/schemas/VersionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "读取成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "这个身份从未出现过。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "410": {
            "description": "实体或版本已被删除，见 [HISTORY-8](/core/rules/history#history-8)。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/entities": {
      "get": {
        "operationId": "listEntities",
        "summary": "列出实体",
        "description": "列出实体的当前版本，按 EntityId 升序分页。`category` 和 `resourceName` 都省略时列出全部实体；给出 `resourceName` 时只返回这种业务类型的实体。列出全部 EntitySchema 用 `category=entity_schema`。",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "只返回这一类内容的实体。",
            "schema": {
              "$ref": "#/components/schemas/Category"
            }
          },
          {
            "name": "resourceName",
            "in": "query",
            "required": false,
            "description": "业务类型的资源名。只返回这种业务类型的实体。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "一页最多返回的版本数。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "上一页响应中的 `next`。省略时从第一页开始。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "一页实体的当前版本。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionPage"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "没有 EntitySchema 使用这个 `resourceName`。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/entities/{entityId}": {
      "get": {
        "operationId": "getEntity",
        "summary": "读取当前版本",
        "description": "读取实体的当前版本，见 [VERSION-5](/core/model/version#version-5)。",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "实体的 EntityId。",
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实体的当前版本。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "这个身份从未出现过。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "410": {
            "description": "实体或版本已被删除，见 [HISTORY-8](/core/rules/history#history-8)。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteEntity",
        "summary": "删除实体",
        "description": "删除实体的全部版本，见 [HISTORY-6](/core/rules/history#history-6)。删除后实体不再接受新版本，见 [HISTORY-7](/core/rules/history#history-7)。删除已删除的实体也返回 `204`。",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "实体的 EntityId。",
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "实体已删除，或者之前已经删除。无响应体。"
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "这个身份从未出现过。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "还有业务版本使用这个 EntitySchema，见 [HISTORY-9](/core/rules/history#history-9)。`rule` 为 `HISTORY-9`。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/entities/{entityId}/versions": {
      "get": {
        "operationId": "listEntityVersions",
        "summary": "读取版本链",
        "description": "读取实体的全部版本，按版本链从首版到当前版排列，不分页。",
        "parameters": [
          {
