    "/entities/{entityId}/referrers": {
      "get": {
        "operationId": "listReferrers",
        "summary": "列出引用方",
        "description": "列出在 `content` 中引用这个实体的版本，目标按实体匹配，引用它的任何一个版本都算，见 [ENTITY-7](/core/model/entity#entity-7)。只返回直接的引用方，按引用方的 VersionId 升序分页。目标实体已被删除时照常列出，见 [HISTORY-8](/core/rules/history#history-8)。",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "目标实体的 EntityId。",
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          },
          {
            "name": "versions",
            "in": "query",
            "required": false,
            "description": "`current` 只返回当前版本仍引用目标的实体，每个实体一个版本；`all` 返回每一个引用过目标的版本。",
            "schema": {
              "type": "string",
              "enum": [
                "current",
                "all"
              ],
              "default": "current"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "一页最多返回的引用方版本数。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "上一页响应中的 `next`。省略时从第一页开始。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "一页引用方。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferrerPage"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "这个身份从未出现过。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/observations": {
      "get": {
        "operationId": "listObservations",
        "summary": "按事实时间查询观测",
        "description": "列出事实时间落在 `[from, to)` 中的 Observation 的当前版本。匹配只看已知的边界：时段与范围有重叠即返回；只知道一个边界时，按这一刻的时间点匹配；两个边界都未知的 Observation 不返回。结果按已知的开始边界升序分页，开始未知时用结束边界，相同时按 EntityId 升序。",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "范围的开始，包含在内。",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "范围的结束，不包含在内，必须晚于 `from`。",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "resourceName",
            "in": "query",
            "required": false,
            "description": "观测内容的资源名。只返回观测内容属于这种业务类型的 Observation。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "一页最多返回的版本数。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "上一页响应中的 `next`。省略时从第一页开始。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "一页 Observation 的当前版本。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionPage"
                }
              }
            }
          },
          "400": {
            "description": "路径中的 ID 不是 UUID，或者参数无效。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "没有 EntitySchema 使用这个 `resourceName`。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "后端出现意外错误。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/observation-drafts/{entityId}": {
      "put": {
        "operationId": "putObservationDraft",
        "summary": "写入观测草稿",
        "description": "写入一份 Observation 尚未保存的最新陈述，见 [API · 观测草稿](/api#drafts)。`sequence` 不大于已暂存草稿的 `sequence` 时，草稿保持不变，响应返回已暂存的草稿。",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "Observation 的 EntityId。",
            "schema": {
              "$ref": "#/components/schemas/EntityId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservationDraftSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "暂存的草稿。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationDraft"
                }
              }
            }
          },
          "400": {
            "description": "请求体或参数不符合契约，或者草稿违反 Core 规则。违反规则时带 `rule`，见 [OBSERVATION-12](/core/model/observation#observation-12)。",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "草稿与已保存的数据冲突，带 `rule`：`previousVersionId` 不是实体的当前版本时为 `VERSION-6`，实体已被删除时为 `HISTORY-7`。",
