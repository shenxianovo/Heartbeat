          }
        }
      },
      "SubmissionProblem": {
        "description": "提交失败时的错误。某个版本被拒绝时带 `index` 和 `versionId`：位置在它之前的版本都已保存，之后的版本没有处理。",
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "description": "被拒绝的版本在 `versions` 中的位置，从 0 开始。"
              },
              "versionId": {
                "$ref": "#/components/schemas/VersionId"
              }
            }
          }
        ]
      },
      "ReferrerPage": {
        "type": "object",
        "required": [
          "referrers",
          "next"
        ],
        "properties": {
          "referrers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Referrer"
            }
          },
          "next": {
            "description": "下一页的游标，作为 `after` 传入。没有下一页时为 `null`。",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Referrer": {
        "type": "object",
        "description": "一个引用了目标实体的版本，以及其中引用目标的位置。",
        "required": [
          "version",
          "references"
        ],
        "properties": {
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "description": "这个版本中引用目标实体的每个位置，无序。",
            "items": {
              "$ref": "#/components/schemas/ReferenceLocation"
            }
          }
        }
      },
      "ReferenceLocation": {
        "type": "object",
        "required": [
          "path",
          "targetVersionId"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "引用所在的位置，是从版本根部写起的 JSON Pointer（[RFC 6901](https://www.rfc-editor.org/rfc/rfc6901.html)），例如 `/content/contentVersionId`、`/content/members/3`。"
          },
          "targetVersionId": {
            "description": "这个位置的值，是目标实体的一个版本。",
            "$ref": "#/components/schemas/VersionId"
          }
        }
      },
      "ObservationDraftSubmission": {
        "type": "object",
        "description": "写入的观测草稿，见 [API · 观测草稿](/api#drafts)。",
        "required": [
          "previousVersionId",
          "sequence",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "previousVersionId": {
            "description": "实体的当前版本，实体还没有版本时为 `null`，见 [OBSERVATION-13](/core/model/observation#observation-13)。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "写入方为这份草稿生成的递增整数。"
          },
          "content": {
            "$ref": "#/components/schemas/Observation"
          }
        }
      },
      "ObservationDraft": {
        "type": "object",
        "description": "后端暂存的观测草稿，见 [OBSERVATION-11](/core/model/observation#observation-11)。",
        "required": [
          "entityId",
          "previousVersionId",
          "sequence",
          "updatedAt",
          "content"
        ],
        "properties": {
          "entityId": {
            "$ref": "#/components/schemas/EntityId"
          },
          "previousVersionId": {
            "description": "实体的当前版本，实体还没有版本时为 `null`，见 [OBSERVATION-13](/core/model/observation#observation-13)。",
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionId"
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "写入方为这份草稿生成的递增整数。"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "后端最近一次接受这份草稿的时刻，以 `Z` 结尾。"
          },
          "content": {
            "$ref": "#/components/schemas/Observation"
          }
        }
      },
      "ObservationDraftList": {
        "type": "object",
        "required": [
          "drafts"
        ],
        "properties": {
          "drafts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservationDraft"
            }
          }
        }
      }
    }
  }
}
